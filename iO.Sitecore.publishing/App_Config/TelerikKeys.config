<?xml version="1.0" encoding="utf-8"?>
<!--
  Demo placeholders — replace before any shared/production Sitecore instance.
  Copy from TelerikKeys.config.example if you need a fresh template.
  Generate keys with:
    -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 64 | ForEach-Object {[char]$_})
-->
<appSettings>
  <add key="Telerik.AsyncUpload.ConfigurationEncryptionKey" value="REPLACE_ME_TELERIK_ASYNCUPLOAD_CONFIGURATION_ENCRYPTION_KEY" />
  <add key="Telerik.Upload.ConfigurationHashKey" value="REPLACE_ME_TELERIK_UPLOAD_CONFIGURATION_HASH_KEY" />
  <add key="Telerik.Web.UI.DialogParametersEncryptionKey" value="REPLACE_ME_TELERIK_DIALOG_PARAMETERS_ENCRYPTION_KEY" />
</appSettings>
